<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" 
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" 
              name="monthly_sales_report" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
    
    <queryString>
        <![CDATA[
            SELECT s.sale_id, c.name AS customer_name, s.sale_date, s.payment_method, s.payment_status, s.total_amount
            FROM sale s
            JOIN customer c ON s.customer_id = c.customer_id
            WHERE MONTH(s.sale_date) = MONTH(CURRENT_DATE()) AND YEAR(s.sale_date) = YEAR(CURRENT_DATE())
            ORDER BY s.sale_date ASC
        ]]>
    </queryString>

    <field name="sale_id" class="java.lang.Integer"/>
    <field name="customer_name" class="java.lang.String"/>
    <field name="sale_date" class="java.sql.Timestamp"/>
    <field name="payment_method" class="java.lang.String"/>
    <field name="payment_status" class="java.lang.String"/>
    <field name="total_amount" class="java.lang.Double"/>

    <variable name="GRAND_TOTAL" class="java.lang.Double" calculation="Sum">
        <variableExpression><![CDATA[$F{total_amount}]]></variableExpression>
    </variable>

    <title>
        <band height="60">
            <staticText>
                <reportElement x="0" y="10" width="555" height="30"/>
                <textElement textAlignment="Center">
                    <font size="20" isBold="true"/>
                </textElement>
                <text><![CDATA[MONTHLY SALES REPORT]]></text>
            </staticText>
        </band>
    </title>

    <columnHeader>
        <band height="25">
            <staticText>
                <reportElement x="0" y="0" width="60" height="20"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Sale ID]]></text>
            </staticText>
            <staticText>
                <reportElement x="60" y="0" width="140" height="20"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Customer Name]]></text>
            </staticText>
            <staticText>
                <reportElement x="200" y="0" width="120" height="20"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Date & Time]]></text>
            </staticText>
            <staticText>
                <reportElement x="320" y="0" width="80" height="20"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Method]]></text>
            </staticText>
            <staticText>
                <reportElement x="400" y="0" width="70" height="20"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Status]]></text>
            </staticText>
            <staticText>
                <reportElement x="470" y="0" width="85" height="20"/>
                <textElement textAlignment="Right"><font isBold="true"/></textElement>
                <text><![CDATA[Total (LKR)]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="20">
            <textField>
                <reportElement x="0" y="0" width="60" height="20"/>
                <textFieldExpression><![CDATA[$F{sale_id}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="60" y="0" width="140" height="20"/>
                <textFieldExpression><![CDATA[$F{customer_name}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="200" y="0" width="120" height="20"/>
                <textFieldExpression><![CDATA[$F{sale_date}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="320" y="0" width="80" height="20"/>
                <textFieldExpression><![CDATA[$F{payment_method}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="400" y="0" width="70" height="20"/>
                <textFieldExpression><![CDATA[$F{payment_status}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="470" y="0" width="85" height="20"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$F{total_amount}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <summary>
        <band height="30">
            <staticText>
                <reportElement x="280" y="5" width="150" height="20"/>
                <textElement textAlignment="Right"><font size="12" isBold="true"/></textElement>
                <text><![CDATA[Grand Total:]]></text>
            </staticText>
            <textField pattern="'LKR '#,##0.00">
                <reportElement x="430" y="5" width="125" height="20"/>
                <textElement textAlignment="Right"><font size="12" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$V{GRAND_TOTAL}]]></textFieldExpression>
            </textField>
        </band>
    </summary>
</jasperReport>